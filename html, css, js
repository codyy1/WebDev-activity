    padding: 10px;
    font-size: 1rem;
  }
  
  
  #result {
    font-weight: bold;
    font-size: 1.5rem;
    color: #007bff;
  }
  
  
  .btn-primary {
    background-color: #007bff;
    border-color: #007bff;
